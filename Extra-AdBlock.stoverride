    - ^https?:\/\/home\.mi\.com\/cgi-op\/api\/v\d\/resource\/realtime\/openingBanner - reject-dict


    # ==================================================
    # Fitdays
    # ==================================================
    - ^https?:\/\/open\.fitdays\.cn\/uploads\/ad\/ - reject


    # ==================================================
    # 华住会
    # ==================================================
    - ^https?:\/\/appapi\.huazhu\.com:\d+\/client\/app\/getAppStartPage\/ - reject
    - ^https?:\/\/hweb-manager\.huazhu\.com\/start\/getAppStartPage - reject
    - ^https?:\/\/hweb-manager\.huazhu\.com\/notice\/getAppPopupNotifyAlert - reject-dict
    - ^https?:\/\/hweb-manager\.huazhu\.com\/hotels\/ad\/ - reject-dict

    # Kelee V6：首页营销 Banner
    - ^https:\/\/hweb-hotel\.huazhu\.com\/home\/getHomeLoinBanner$ - reject-dict


    # ==================================================
    # 希尔顿
    # ==================================================
    - ^https?:\/\/wcprd\.hilton\.com\.cn\/app-middleware\/graphql\?type=splashAd - reject-200


    # ==================================================
    # 亚朵
    # ==================================================
    - ^https?:\/\/api2\.yaduo\.com\/atourlife\/activity\/appLaunch - reject-dict


    # ==================================================
    # 微博
    # R-Store / RuCu6 低风险广告项
    # ==================================================

    # 开屏广告
    - ^https?:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime - reject-dict

    # 长文章广告 / 赞赏营销
    - ^https?:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead)\? - reject-dict
    - ^https?:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead)\? - reject-dict


    # ==================================================
    # 哔哩哔哩漫画
    # 与 Shiina 普通 Bilibili 模块不同，是独立 App
    # 仅处理广告、营销、弹窗、额外推荐
    # ==================================================

    # 小说额外推荐
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/novel\.v\d+\.Novel\/MoreRecommend - reject-dict

    # 漫画推荐 / 开屏 / 活动 / Banner
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d+\.Comic\/(?:MoreRecommend|(?:List)?Flash|GetActivityTab|GetOperaterBanner|GetHookBanner|SearchBanner) - reject-200

    # 营销弹窗
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d+\.PopUp\/GetAvailablePopUp - reject-dict

    # 营销中心
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d+\.User\/GetMarketingCenterInfo - reject-dict


    # ==================================================
    # 京东
    # Shiina Lite 已处理开屏；这里只补 Kelee 低风险项
    # ==================================================
    - ^https:\/\/api\.m\.jd\.com\/client\.action\?[^#]*\bfunctionId=(?:searchBoxWord|stationPullService|uniformRecommend[06])(?:&|$) - reject-dict


    # ==================================================
    # 拼多多
    # Shiina Lite 已处理开屏；V6 只补低价值推荐
    # ==================================================
    - ^https:\/\/api\.pinduoduo\.com\/search_hotquery\? - reject-dict
    - ^https:\/\/api\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather\? - reject-dict
    - ^https:\/\/api\.pinduoduo\.com\/api\/buffon\/nasus\/recommend\? - reject-dict


    # ==================================================
    # 闲鱼
    # Shiina Lite 已过滤主信息流广告
    # Kelee V6 补推荐/搜索营销
    # ==================================================
    - ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.user\.strategy\.list\/ - reject-dict
    - ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.item\.buy\.feeds\/ - reject-dict
    - ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlemtopsearch\.search\.shade\/ - reject-dict
    - ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.playboy\.recommend\/ - reject-dict
    - ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.local\.near\.by\.corner\.info\/ - reject-dict


    # ==================================================
    # 小红书
    # Shiina Lite 已过滤开屏/信息流广告
    # Kelee V6 补搜索及引导营销
    # ==================================================
    - ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/(?:v2\/guide\/user_banner|v3\/note\/guide) - reject-dict
    - ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/banner_list$ - reject-dict
    - ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/search\/hot_list$ - reject-dict
    - ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/hint - reject-dict
    - ^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v4\/search\/trending\? - reject-dict


  script:
    # ==================================================
    # 航旅纵横
    # R-Store：按广告 rpid 精确过滤
    # ==================================================
    - match: ^https?:\/\/(?:bkclient|umerp|home)\.umetrip\.com(?:\.cn)?\/gateway\/api\/umetrip\/native
      name: Umetrip.AdBlock
      type: response
      require-body: false
      timeout: 10

    # ==================================================
    # 铁路12306
    # Kelee：活动横幅、热门资讯、商品信息流、商业推广
    # 不修改购票/订单/登录
    # ==================================================
    - match: ^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$
      name: Kelee.12306.Clean
      type: request
      require-body: false
      timeout: 10

    # ==================================================
    # 高德地图
    # Kelee：只启用几个广告属性非常明确的接口
    # 不启用其“精简首页/我的页面”的激进规则
    # ==================================================
    - match: ^https:\/\/m5\.amap\.com\/ws\/shield\/search_bff\/hotword\?
      name: Kelee.Amap.Clean
      type: response
      require-body: true
      timeout: 10

    - match: ^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/(?:mps|search\/sp|sug|tips_operation_location)
      name: Kelee.Amap.Clean
      type: response
      require-body: true
      timeout: 10

    - match: ^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\?
      name: Kelee.Amap.Clean
      type: response
      require-body: true
      timeout: 10


script-providers:
  Umetrip.AdBlock:
    url: https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/umetrip.js
    interval: 86400

  Kelee.12306.Clean:
    url: https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/JavaScript/Kelee/12306_remove_ads/kelee.one_12306_remove_ads.js
    interval: 86400

  Kelee.Amap.Clean:
    url: https://raw.githubusercontent.com/ifflagged/Romeo/main/Modules/JavaScript/Kelee/Amap_remove_ads/kelee.one_Amap_remove_ads.js
    interval: 86400
